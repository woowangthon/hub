{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["teamNumber", "teamName", "title", "summary", "thumbnail", "screenshots", "problem", "features", "targetUsers", "techStack", "techHighlights", "repositoryUrl", "demoVideoUrl", "members"],
  "properties": {
    "teamNumber": {"type": "integer", "minimum": 1, "maximum": 99},
    "teamName": {"$ref": "#/definitions/text"},
    "title": {"$ref": "#/definitions/text"},
    "summary": {"$ref": "#/definitions/text"},
    "thumbnail": {"$ref": "#/definitions/text"},
    "screenshots": {"$ref": "#/definitions/textList"},
    "problem": {"$ref": "#/definitions/text"},
    "features": {"$ref": "#/definitions/textList"},
    "targetUsers": {"$ref": "#/definitions/textList"},
    "techStack": {"$ref": "#/definitions/textList"},
    "techHighlights": {"$ref": "#/definitions/textList"},
    "repositoryUrl": {"type": "string", "format": "repository"},
    "demoUrl": {"anyOf": [{"const": ""}, {"type": "string", "format": "web-url"}]},
    "demoVideoUrl": {"type": "string", "format": "https-url"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "roles", "contribution"],
        "properties": {
          "name": {"$ref": "#/definitions/text"},
          "roles": {"$ref": "#/definitions/textList"},
          "contribution": {"$ref": "#/definitions/text"}
        }
      }
    }
  },
  "definitions": {
    "text": {"type": "string", "pattern": "\\S"},
    "textList": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}}
  }
}
